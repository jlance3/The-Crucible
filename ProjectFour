def getTimecode(frame):
    #Assuming that it is 24fps...
    hours = frame // (24 * 60 * 60)
    excesshr = frame % (24 * 60 * 60) # remaining frames after calculating hours
    minutes = excesshr // (24 * 60)
    excessmin = excesshr % (24 * 60) # remaining frames after calculating minutes
    seconds = excessmin // 24
    excessFinal = excessmin % 24 # remaining frames after calculating seconds

    #return timecode
    return f"{hours:02}:{minutes:02}:{seconds:02}:{excessFinal:02}"

def Processing(db_name, collection1, video_file):
    #calling database and getting Planeshifter frames
    client = pymongo.MongoClient("mongodb+srv://lancestajimenez_db_user:wcHp8TWnJvdYi74Y@testcluster.vb9fgy4.mongodb.net/")
    db = client[db_name]
    col1 = db[collection1]
    query1 = {
        "$and": [ #checking for keywords in proper columns
            {"finalLocation": {"$regex": "planeshifter", "$options": "i"}}, #made sure to account for capitalization, all good :)
        ]
    }

    results1 = list(col1.find(query1))
    df1 = pd.DataFrame(results1)
    dfFinal = df1.drop_duplicates(subset=["finalLocation", "FrameNumbers"])

    #extracting frame numbers from that list and creating a mapping to locations
    frame_to_location = {}  # Dictionary to map frame numbers to their locations
    for index, row in dfFinal.iterrows():
        frame_range = row['FrameNumbers']
        if '-' in frame_range:
            start_frame, end_frame = map(int, frame_range.split('-'))
            for frame in range(start_frame, end_frame + 1):
                frame_to_location[frame] = row['finalLocation']
        else:
            frame_num = int(frame_range)
            frame_to_location[frame_num] = row['finalLocation']
    
    frame_numbers = sorted(frame_to_location.keys())  # Get sorted unique frame numbers
    print("Extracted Frame Numbers:", frame_numbers)

    #organizing frames, timecodes, and locations
    for num in frame_numbers:
        #getting frame ranges
        start_frame = max(0, num - 48)  # Ensure start frame is not negative
        end_frame = num + 48

        #get timecode for start_frame and end_frame
        start_timecode = getTimecode(start_frame)
        end_timecode = getTimecode(end_frame)
        timecode = f"{start_timecode} - {end_timecode}"

        #put into truefinalList for xls file later
        truefinalList["Location"].append(frame_to_location[num])
        truefinalList["FrameRange"].append(f"{start_frame}-{end_frame}")
        truefinalList["TimeCode"].append(timecode)
        testtruefinalList = pd.DataFrame(truefinalList)
    print(testtruefinalList)

    #using timecode ranges to take out a portion of a video file with subprocess/ffmpeg
    for index, row in testtruefinalList.iterrows():
        frame_range = row['FrameRange']
        start_frame, end_frame = map(int, frame_range.split('-'))
        
        # Convert frames to seconds for ffmpeg (24 fps)
        start_seconds = start_frame / 24 #changed
        duration_frames = end_frame - start_frame
        duration_seconds = duration_frames / 24  # Assuming 24 fps

        output_filename = f"output_Planeshifter_frames_{frame_range}.mp4"

        ffmpeg_command = [
            'ffmpeg',
            '-i', video_file,
            '-ss', str(start_seconds), #changed
            '-t', str(duration_seconds),
            '-c', 'copy',
            output_filename
        ]

        print(f"Executing command: {' '.join(ffmpeg_command)}")
        subprocess.run(ffmpeg_command)



