#added function for frame extraction (instead of copy-pasting the method 1000 FREAKING TIMES)
def frameExtraction(line, newlocation):
    intialnum = 0
    nextnum = 0             #starting numbers to identify range (thanks for the hint Prof)
    currentnum = 0
    for word in line.split():  #looks at each word in the line 
        if word.isdigit():      #if the word is a number...
            if intialnum == 0:          #if case for the very first number
                intialnum = int(word)
                currentnum = intialnum
            elif nextnum == 0:           #elif once we are on the second number
                nextnum = int(word)
                if nextnum - intialnum == 1: #check if the difference between the two numbers is 1 (for range)
                    currentnum = nextnum    #if so, continue through loop to extend range
                else:               #if NOT in range, decide whether to add a single digit or the range
                    if intialnum == currentnum: #if only one number, append that number
                        finalList["finalLocation"].append(newlocation.split()[0]) 
                        finalList["FrameNumbers"].append(f"{intialnum}")
                    else: #if more than one number, append range
                        finalList["finalLocation"].append(newlocation.split()[0]) 
                        finalList["FrameNumbers"].append(f"{intialnum}-{currentnum}")   #appends as a range
                    intialnum = int(word) #reset intialnum to the new number
                    currentnum = intialnum #reset currentnum to the new number
                nextnum = 0 #restarts the process
    
    #fixes issue of ending ranges too early
    if intialnum != 0:
        if intialnum == currentnum:
            finalList["finalLocation"].append(newlocation)
            finalList["FrameNumbers"].append(f"{intialnum}")

        else:
            finalList["finalLocation"].append(newlocation)
            finalList["FrameNumbers"].append(f"{intialnum}-{currentnum}")

