def getTimecode(frame):
    #Assuming that it is 24fps...
    hours = frame // (24 * 60 * 60)
    excesshr = frame % (24 * 60 * 60) # remaining frames after calculating hours
    minutes = excesshr // (24 * 60)
    excessmin = excesshr % (24 * 60) # remaining frames after calculating minutes
    seconds = excessmin // 24
    excessFinal = excessmin % 24 # remaining frames after calculating seconds

    #return timecode
    return f"{hours:02}:{minutes:02}:{seconds:02}:{excessFinal:02}"

def Processing(db_name, collection1, video_file):
