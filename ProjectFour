#thumbnail creation, and xls creation/manipulation
def finalOutput (db_name, collection1, video_file):
    #taking dataframe from Processing method for xls conversion (also creates adds to the folder of video snippets for thumbnails + vimeo upload later)
    DFtruefinalList = Processing(db_name, collection1, video_file)

    #naming final file now to make it easier to read
    xls_filename = "FinalOutputDatasheet.xlsx"

    #creating thumbnails and adding to xls file as a new column
    folder = 'VideoOutputFolder'
    thumbnail_folder = 'Thumbnails'
    os.makedirs(thumbnail_folder, exist_ok=True)  # Ensure the thumbnail folder exists
    thumbnail_paths = []  # List to store thumbnail paths
    for index, row in DFtruefinalList.iterrows():
        frame_range = row['FrameRange']
        output_video_path = os.path.join(folder, f"output_Planeshifter_frames_{frame_range}.mp4")
        thumbnail_path = os.path.join(thumbnail_folder, f"thumbnail_frames_{frame_range}.jpg")

        ffmpeg_thumbnail_command = [
            'ffmpeg',
            '-i', output_video_path,
            '-ss', '00:00:01.000',  # Capture thumbnail at 1 second
            '-vf', 'scale=96:74', 
            '-vframes', '1',
            '-hide_banner',
            thumbnail_path
        ]

        print(f"Executing command: {' '.join(ffmpeg_thumbnail_command)}")
        subprocess.run(ffmpeg_thumbnail_command)
        thumbnail_paths.append(thumbnail_path)

    # using openpyxl to import thumbnails into datasheet (new shit to figure out)
    workbook = openpyxl.Workbook()
    sheet = workbook.active
    sheet.title = "Datasheet"

    # Write headers
    headers = ['Location', 'FrameRange', 'TimeCode', 'Thumbnail']
    for col_num, header in enumerate(headers, 1):
        sheet.cell(row=1, column=col_num, value=header)

    # Writes existing data
    for row_num, (index, row) in enumerate(DFtruefinalList.iterrows(), 2):
        sheet.cell(row=row_num, column=1, value=row['Location'])
        sheet.cell(row=row_num, column=2, value=row['FrameRange'])
        sheet.cell(row=row_num, column=3, value=row['TimeCode'])
        # puts in the thumbnail image
        img_path = thumbnail_paths[index]  # matching with index
        if os.path.exists(img_path): #checking for thumbnail
            img = openpyxl.drawing.image.Image(img_path) #assigns image (img) to the path found in list
            img.anchor = f'D{row_num}'  # Column for Thumbnail
            sheet.add_image(img) #slaps it on

    workbook.save(xls_filename)
    print(f"Final datasheet with embedded thumbnails saved as {xls_filename}")

